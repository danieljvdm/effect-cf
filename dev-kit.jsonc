{
  "$schema": "./node_modules/@danieljvdm/dev-kit/schema/dev-kit.schema.json",
  "include": ["dev-kit", "effect", "testing", "cloudflare", "@effect-cf/repo#pr-hygiene"],
  "setup": {
    "agentInstructions": { "enabled": true },
    "claudeInstructions": { "enabled": true },
    "effectSource": { "enabled": true },
    "effectTsgo": { "enabled": true },
    "vitePlus": {
      "hooks": { "enabled": true },
      "quality": {
        "workflow": {
          "enabled": true,
          // Examples and the worker test fixtures resolve `effect-cf` through
          // its published `dist` entrypoints.
          "beforeChecks": [
            {
              "name": "Build effect-cf",
              "run": ["vp run effect-cf#build"],
            },
          ],
        },
      },
    },
  },
  "targets": {
    "agents": {
      "enabled": true,
      "mode": "copy",
    },
    "claude": {
      "enabled": true,
      "mode": "symlink",
    },
  },
}
