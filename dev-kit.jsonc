{
  "$schema": "./node_modules/@danieljvdm/dev-kit/schema/dev-kit.schema.json",
  "include": [
    "dev-kit",
    "effect",
    "testing",
    "open-pull-request",
    "cloudflare",
    "@effect-cf/repo#pr-hygiene",
    "tdd",
  ],
  "setup": {
    "agentInstructions": { "enabled": true },
    "claudeInstructions": { "enabled": true },
    "effectSource": { "enabled": true },
    "effectTsgo": { "enabled": true },
    "vitePlus": {
      "hooks": { "enabled": true },
      "quality": {
        "workflow": {
          "enabled": true,
          // Examples and the worker test fixtures resolve the publishable
          // packages through their published `dist` entrypoints.
          "beforeChecks": [
            {
              "name": "Build packages",
              "run": ["vp run effect-cf#build", "vp run effect-webtransport#build"],
            },
          ],
        },
      },
    },
  },
  "targets": {
    "agents": {
      "enabled": true,
      "mode": "copy",
    },
    "claude": {
      "enabled": true,
      "mode": "symlink",
    },
  },
}
