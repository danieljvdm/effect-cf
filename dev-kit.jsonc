{
  "$schema": "./node_modules/@danieljvdm/dev-kit/schema/dev-kit.schema.json",
  "include": [
    "dev-kit",
    "effect",
    "testing",
    "open-pull-request",
    "cloudflare",
    "@effect-cf/repo#pr-hygiene",
    "tdd",
  ],
  "setup": {
    "agentInstructions": { "enabled": true },
    "claudeInstructions": { "enabled": true },
    "effectSource": { "enabled": true },
    "effectTsgo": { "enabled": true },
    "vitePlus": {
      "hooks": { "enabled": true },
      // This is a create-once scaffold; the repository-owned workflow keeps
      // its package build steps before the checks.
      "workflow": { "enabled": true },
    },
  },
  "targets": {
    "agents": {
      "enabled": true,
      "mode": "copy",
    },
    "claude": {
      "enabled": true,
      "mode": "symlink",
    },
  },
}
