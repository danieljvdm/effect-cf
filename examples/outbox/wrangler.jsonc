{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "effect-cf-outbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "DOCUMENTS", "class_name": "DocumentDurableObject" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocumentDurableObject"] }],
  "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "effect-cf-document-archive" }],
}
