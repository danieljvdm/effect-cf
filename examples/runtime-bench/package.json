{
  "name": "runtime-bench-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:fresh": "vp exec wrangler dev --local --config wrangler.fresh.jsonc",
    "dev:cached": "vp exec wrangler dev --local --config wrangler.cached.jsonc",
    "dev:rpc": "vp exec wrangler dev --local --config wrangler.rpc.jsonc",
    "dev:telemetry": "vp exec wrangler dev --local --config wrangler.telemetry.jsonc --config wrangler.collector.jsonc",
    "dev:collector": "vp exec wrangler dev --local --config wrangler.collector.jsonc",
    "dev:alarms": "vp exec wrangler dev --local --config wrangler.alarms.jsonc",
    "typecheck": "vp exec tsc --noEmit"
  },
  "dependencies": {
    "effect": "catalog:",
    "effect-cf": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  }
}
