{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "runtime-bench-rpc-local",
  "main": "src/rpc.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat", "new_module_registry"],
  "workers_dev": false,
  "preview_urls": false,
  "services": [
    {
      "binding": "CATALOG",
      "service": "runtime-bench-rpc-local",
      "entrypoint": "Catalog",
    },
  ],
}
