{
  "name": "effect-cf-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*/packages/*",
    "examples/*/workers/*",
    "examples/*/durable-objects/*",
    "examples/*/web",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent --hooks-dir .vite-hooks",
    "patch:tsgo": "bun scripts/patch-effect-tsgo.ts",
    "ready": "vp run check && vp run -r build",
    "changeset": "vp exec changeset",
    "changeset:version": "vp exec changeset version",
    "changeset:publish": "vp exec changeset publish",
    "dev": "vp run chat-api-worker#dev",
    "dev:web": "vp run chat-web#dev",
    "dev:todo-http-api": "vp run todo-http-api-worker#dev",
    "dev:todo-http-web": "vp run todo-http-web#dev",
    "dev:todo-http": "vp run todo-http-web#dev",
    "build:todo-http": "vp run todo-http-domain#build && vp run todo-http-api-worker#build && vp run todo-http-web#build",
    "dev:todo-rpc-http-api": "vp run todo-rpc-http-api-worker#dev",
    "dev:todo-rpc-http-web": "vp run todo-rpc-http-web#dev",
    "dev:todo-rpc-http": "vp run todo-rpc-http-web#dev",
    "build:todo-rpc-http": "vp run todo-rpc-http-domain#build && vp run todo-rpc-http-api-worker#build && vp run todo-rpc-http-web#build",
    "dev:todo-rpc-ws-api": "vp run todo-rpc-ws-api-worker#dev",
    "dev:todo-rpc-ws-web": "vp run todo-rpc-ws-web#dev",
    "dev:todo-rpc-ws": "vp run todo-rpc-ws-web#dev",
    "build:todo-rpc-ws": "vp run todo-rpc-ws-domain#build && vp run todo-rpc-ws-store-do#build && vp run todo-rpc-ws-api-worker#build && vp run todo-rpc-ws-web#build"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@cloudflare/vitest-plugin": "catalog:",
    "@effect-cf/repo": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "0.36.4",
    "@oxlint/plugins": "1.78.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.6.0",
    "effect": "catalog:",
    "oxfmt": "0.60.0",
    "oxlint": "1.78.0",
    "typescript": "7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "overrides": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/platform-node-shared": "^4.0.0-rc.110",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/workers-types": "5.20260820.1",
    "@cloudflare/vitest-plugin": "1.0.0",
    "@effect/platform-node": "^4.0.0-rc.110",
    "@effect/sql-d1": "^4.0.0-rc.110",
    "@effect/sql-pg": "^4.0.0-rc.110",
    "@effect/sql-sqlite-do": "^4.0.0-rc.110",
    "@effect/vitest": "^4.0.0-rc.110",
    "effect": "^4.0.0-rc.110",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
    "vitest": "4.1.10",
    "vite-plus": "0.2.6",
    "wrangler": "4.125.0"
  }
}
