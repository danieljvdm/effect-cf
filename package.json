{
  "name": "effect-cf-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent --hooks-dir .vite-hooks",
    "patch:tsgo": "bun scripts/patch-effect-tsgo.ts",
    "ready": "vp run check && vp run -r build",
    "changeset": "vp exec changeset",
    "changeset:version": "vp exec changeset version",
    "changeset:publish": "vp exec changeset publish",
    "dev": "vp run effect-cf#build && vp run counter-example#dev"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@cloudflare/vitest-plugin": "catalog:",
    "@effect-cf/repo": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "0.36.4",
    "@oxlint/plugins": "1.79.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^25.6.0",
    "effect": "catalog:",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "typescript": "7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "overrides": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/platform-node-shared": "^4.0.0-rc.112",
    "miniflare": "catalog:",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.0",
  "catalog": {
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/workers-types": "5.20260825.1",
    "@cloudflare/vitest-plugin": "1.0.0",
    "@effect/platform-node": "^4.0.0-rc.112",
    "@effect/sql-d1": "^4.0.0-rc.112",
    "@effect/sql-pg": "^4.0.0-rc.112",
    "@effect/sql-sqlite-do": "^4.0.0-rc.112",
    "@effect/vitest": "^4.0.0-rc.112",
    "effect": "^4.0.0-rc.112",
    "miniflare": "5.20260825.0-alpha",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vitest": "4.1.11",
    "vite-plus": "0.3.0",
    "wrangler": "4.126.0"
  }
}
