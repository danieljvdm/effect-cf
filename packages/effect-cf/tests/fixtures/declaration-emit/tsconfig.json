{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"],
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/*.ts"]
}
