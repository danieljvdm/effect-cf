{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "instanceOfSchema": "suggestion",
          "nestedEffectGenYield": "suggestion",
          "newSchemaClass": "suggestion",
          "preferSchemaTypeProperty": "suggestion",
          // `rpc` deliberately returns Cloudflare's unresolved RPC result, whose
          // type is a Promise intersection. That is the documented difference
          // from `call`, so this rule does not apply to this codebase.
          "promiseInEffectSuccess": "off",
          // Dev Kit's recommended profile sets this to `warning`; keep it there
          // explicitly so new unsafe assertions fail rather than falling back to
          // the language service's lower default. Existing exceptions carry a
          // per-site `@effect-diagnostics-next-line` directive and a reason.
          "unsafeEffectTypeAssertion": "warning",
          // Remaining backlog. The compiler exits non-zero on warnings, and the
          // Cloudflare host boundaries still produce these, so keep the guidance
          // visible in editors at `suggestion` until the error channels are typed.
          // Tracked in https://github.com/danieljvdm/effect-cf/issues/63 —
          // drop each override as its count reaches zero.
          "anyUnknownInErrorContext": "suggestion",
          "unknownInEffectCatch": "suggestion"
        },
        "overrides": [
          {
            "include": ["**/src/**/*.ts"],
            "options": {
              "diagnosticSeverity": {
                "nodeBuiltinImport": "warning",
                "preferSchemaOverJson": "suggestion"
              }
            }
          }
        ]
      }
    ]
  },
  "include": ["vite.config.ts"]
}
